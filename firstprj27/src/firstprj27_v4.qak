System firstprj27
ModelFor Project: firstprj27_v4
mqttBroker "localhost" : 1883 eventTopic "firstprj27rIn"
/*  
 * 
 *
 */ 
Request  evalfun : arg(V)
Reply evalreply  : value(V) for evalfun

Request  evalfunvalues : args(MIN,MAX,DX)
Reply    replyvalues   : values(S) for evalfunvalues


Event serviceworking : serviceworking(V)

Context ctxfirstprj27 ip [ host="localhost" port=8120 ]

QActor a context ctxfirstprj27 { 
	State s0 initial{
		[#  clearlog("./logs/app_firstprj27.log") 	//vedi src/main/resources/logback.xml #]
 		println( "$name STARTS") color blue
	}
	Goto waitrequest
	
	State waitrequest{ 
		println( "$name - waiting for some request ...") color blue
	}
	Transition t0
		whenRequest evalfun       -> doeval
		whenRequest evalfunvalues -> doevalvalues

	State doeval{ 
		emit serviceworking : serviceworking( evalfun )
		onMsg( evalfun : arg(V) ){
			[# val V = payloadArg(0)            #]
			println( "$name - evalfun for $V ") color blue
			[# val R = MyCode.FSin.evalStr( V ) #]
 			println( "$name - answer $R for $V ") color blue
			replyTo evalfun with evalreply : value($R)
		}
	}
	Goto waitrequest
			 
	State doevalvalues{ 
		emit serviceworking : serviceworking( doevalvalues )
		printCurrentMessage color green
		onMsg( evalfunvalues : args(A,B,C) ){
			[# val Min = payloadArg(0).toDouble()             #]
			[# val Max = payloadArg(1).toDouble()             #]
			[# val Dx  = payloadArg(2).toDouble()             #]
			println( "$name - doevalvalues  Min=$Min Max=$Max Dx=$Dx ") color magenta
			//Inserisco apici per creare una String usabile come termine Prolog nella reply
			[# val R = "'" + MyCode.FSinSeries.evalSinPoints( Min,Max,Dx ) + "'" #]		
  			println( "$name - values: $R  ") color green
			replyTo evalfunvalues with replyvalues : values($R)
		}
	}
	Goto waitrequest
}

