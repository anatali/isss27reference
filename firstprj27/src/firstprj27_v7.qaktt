/*
 * Attore introdotto per quick testing degli EVENTI
 */
 
QActor emitterforquicktesting context ctxfirstprj27{
	State s0 initial{
		println( "$name - STARTS   ") color magenta
			[# val Min = "-2.0"   #] 
			[# val Max = "2.0"    #]
			[# val Dx  = "0.1"    #]
		//request a -m evalfunvalues : args($Min, $Max, $Dx)
		delay 1000
		println("$name - starteval   ") color magenta
		emit starteval : starteval( $Min, $Max, $Dx )
		delay 500
		println("$name - stopeval   ") color magenta
		emit stopeval : stopeval( ok )
	}
	Transition t0 
		whenEvent  stopeval -> handlestop
		
	State handlestop{
		// never here !!!!!!!!!!!!
		printCurrentMessage color red
	}	
 
}//emitterforquicktesting


