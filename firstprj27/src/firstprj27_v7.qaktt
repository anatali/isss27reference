System /* -trace */ firstprj27
ModelFor Project: firstprj27_v7
 
/*  
  * INTERAZIONE a EVENTI 
 * ---------------------------------------------------------------------
 * Genera, a richiesta, una serie di valori della funzione MyCode.FSin
 * da MIN a MAX con intervallo DX
 * 
 *  
 */   

Request  evalfunvalues : args(MIN,MAX,DX) 
Reply    replyvalues   : values(S) for evalfunvalues
 
Event starteval      : starteval(MIN,MAX,DX)
Event stopeval       : stopeval(V)

Dispatch coapUpdate : changed( TERM )  //coapUpdate : Default name se non uso msgid in observeResource
Dispatch evalued    : changed( TERM )  //changed è SEMPRE il payload di una updateresource

Context ctxfirstprj27 ip [ host="localhost" port=8120 ]

QActor a context ctxfirstprj27 { 
	import "MyCode.*"
	
	[# var Min  = 0.0
	   var Max  = 0.0
	   var CurX = 0.0    
	   var Dx   = 0.0 
	#]
	State s0 initial{
		[#  clearlog("./logs/app_firstprj27.log") 	//vedi src/main/resources/logback.xml #]
 		println( "$name STARTS") color blue
	}
	Goto working
	
	State working{ 
		println( "$name - waiting  ...") color blue
	}
	Transition t0
		whenRequest evalfunvalues -> doevalvalues
		whenEvent starteval       -> doStartEval

	State doStartEval{
		onMsg( starteval : starteval( MIN,MAX,DX )){
			[# Min = payloadArg(0).toDouble() #]
			[# Max = payloadArg(1).toDouble() #]
			[# Dx  = payloadArg(2).toDouble() #]
			[# CurX = Min                     #]
			[# FSinSeries.setParams( Min,Max,Dx  )#] 
			println( "$name - doStartEval starteval event done $Min, $Max, $Dx") color blue
			//emit serviceeVal : serviceeVal(start)
		}
	} 
	Goto doEvalAvalue
    

	State doEvalAvalue{		
		//println( "$name - doEvalAvalue  ") color blue
		[# val Y = FSinSeries.evalNextPoint(CurX)           #]
		//emit serviceeVal : serviceeVal($CurX, $Y)
		updateResource [# "serviceeVal($CurX, $Y)" #]   
		
		/*
		 * STRUTTURA dei messaggi inviati
		 * updateResourceRep msg(coapUpdate,dispatch,a,coapobserver,changed( serviceeVal(1.2000000000000008, 0.93) ),32)
		 * updateResourceRep msg(evalued,dispatch,a,coapobserver,changed( serviceeVal(1.2000000000000008, 0.93) ),32)
		 */
		[# CurX = CurX + Dx     #]
	}
	Transition t0
		whenTime 10        -> doEvalAvalue
		whenEvent stopeval -> end
	
	State end{
		println( "$name - ENDS  ") color blue
 	}
 
 
	
	State doevalvalues{ 
		printCurrentMessage color blue
		onMsg( evalfunvalues : args(A,B,C) ){
			[# val Min = payloadArg(0).toDouble()             #]
			[# val Max = payloadArg(1).toDouble()             #]
			[# val Dx  = payloadArg(2).toDouble()             #]
			println( "$name - doevalvalues  Min=$Min Max=$Max Dx=$Dx ") color magenta
			//Inserisco apici per creare una String usabile come termine Prolog nella reply
			[# val R = "'" + MyCode.FSinSeries.evalSinPoints( Min,Max,Dx ) + "'" #]		
//  			println( "$name - values: $R  ") color green
			replyTo evalfunvalues with replyvalues : values($R)
		}
	}
	Goto working
	
	 
}


 

QActor coapobserver context ctxfirstprj27{
	 	import "MyCode.*"
	
 	[# val Labels = ArrayList<String>()  
 	   val Values = ArrayList<String>() #]
 	State s0 initial{
 		println( "$name | STARTS   ") color green
 		observeResource a  msgid evalued
 	}
	Transition t0 
  		whenMsg evalued    -> accumulate	
  		whenMsg coapUpdate -> accumulate
  

	State accumulate{  
 		println("$name | accumulate ${currentMsg.msgId() }")  color green
 		onMsg( evalued : changed( serviceeVal(X,Y) ) ){
 			println("USING msgid evalued") color red 
 			[#
				val T0 = Term.createTerm( payloadArg(0) )  
 				val X = (T0 as Struct).getArg(0).toString().toDouble()        
				val Y = (T0 as Struct).getArg(1).toString().toDouble()  
 			#]
 			[# val SX = ""+String.format(java.util.Locale.US, "%.1f", X)  #]
 			[# val SY = ""+String.format(java.util.Locale.US, "%.3f", Y)  #]
 			[# Labels.add( SX )       #]
 			[# Values.add( SY  )      #]
 			 
 		} 
 		onMsg( coapUpdate : changed( serviceeVal(X,Y) ) ){
 			println("USING coapUpdate") color red
 			[#
				val T0 = Term.createTerm( payloadArg(0) )  
 				val X = (T0 as Struct).getArg(0).toString().toDouble()        
				val Y = (T0 as Struct).getArg(1).toString().toDouble()  
 			#]
 			[# val SX = ""+String.format(java.util.Locale.US, "%.1f", X)  #]
 			[# val SY = ""+String.format(java.util.Locale.US, "%.3f", Y)  #]
 			[# Labels.add( SX )       #]
 			[# Values.add( SY  )      #]
 			
 		} 	
 	}
  	Transition t0 
 		whenMsg evalued       -> accumulate
   		whenMsg coapUpdate    -> accumulate
 		whenEvent stopeval    -> showValues
 
 	State showValues{
		[# var S = FSinSeries.getEvaluedPoints(Labels, Values)          #]
//		println( "$name - showValues  ") color green
		[# val chartUrl = ChartUtils.buildMapChartUrl("Sin", S)        #]
		[# ChartUtils.OpenChartInBrowser(chartUrl)                          #]
		
		[# System.exit(0) #]
	}

} 


